# 실제 값을 커밋하지 마세요.

# 비워두면 MockLLMClient(결정론적, 네트워크 불필요)가 사용됩니다.
# 실제 OpenAI 키를 채우면 OpenAILLMClient가 사용됩니다 -- 아래
# TKAF_LLM_PROVIDER=openai 는 이미 켜져 있으니, 이 줄에 키만 채우면 됩니다.
OPENAI_API_KEY=
TKAF_LLM_PROVIDER=openai
TKAF_LLM_MODEL=gpt-4o-mini

DATABASE_URL=
DATA_SOURCE_TOKEN=

# Prefer a sibling/private directory outside the Git repository.
TKAF_PRIVATE_DATA_ROOT=../tkaf-private-data

# Local runtime DB is generated/imported and never committed.
TKAF_APP_DATABASE_URL=sqlite:///data/runtime/tkaf.local.sqlite3
