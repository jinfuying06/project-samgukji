# 실제 값을 커밋하지 마세요.
OPENAI_API_KEY=
DATABASE_URL=
DATA_SOURCE_TOKEN=

# Prefer a sibling/private directory outside the Git repository.
TKAF_PRIVATE_DATA_ROOT=../tkaf-private-data

# Local runtime DB is generated/imported and never committed.
TKAF_APP_DATABASE_URL=sqlite:///data/runtime/tkaf.local.sqlite3
