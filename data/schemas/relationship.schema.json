{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tkaf.local/schemas/relationship.schema.json",
  "title": "Relationship edge",
  "description": "A directed or undirected relationship edge between two persons, scoped to one source layer. HISTORY_BASE/HISTORY_ANNOTATION and ROMANCE graphs are built separately and only compared after, never merged (agents/_three_kingdoms_domain.md).",
  "type": "object",
  "required": ["edge_id", "from_person_id", "to_person_id", "relation_type", "direction", "source_layer", "confidence", "evidence_refs"],
  "properties": {
    "edge_id": { "type": "string" },
    "from_person_id": { "type": "string", "pattern": "^person\\.[a-z0-9_]+$" },
    "to_person_id": { "type": "string", "pattern": "^person\\.[a-z0-9_]+$" },
    "relation_type": { "type": "string", "description": "e.g. advises, commands, allies_with, opposes, co_occurs_with. co_occurs_with must not be conflated with an actual interaction relation." },
    "direction": { "type": "string", "enum": ["directed", "undirected"] },
    "start": { "type": ["string", "null"] },
    "end": { "type": ["string", "null"] },
    "event_ref": { "type": ["string", "null"], "pattern": "^event\\.[a-z0-9_]+$" },
    "source_layer": { "type": "string", "enum": ["HISTORY_BASE", "HISTORY_ANNOTATION", "ROMANCE", "LATER_INTERPRETATION", "GAME_DATA"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
