{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/relationship.schema.json",
  "title": "Typed Temporal Relationship",
  "type": "object",
  "additionalProperties": false,
  "required": ["relationship_id", "source_person_id", "target_person_id", "type", "directed", "source_layer", "evidence_refs"],
  "properties": {
    "relationship_id": {"type": "string"},
    "source_person_id": {"type": "string"},
    "target_person_id": {"type": "string"},
    "type": {"enum": ["alliance", "command", "advice", "rivalry", "battle", "kinship", "recruitment", "defection", "co_occurrence", "other"]},
    "directed": {"type": "boolean"},
    "source_layer": {"enum": ["HISTORY_BASE", "HISTORY_ANNOTATION", "ROMANCE", "LATER_INTERPRETATION", "GAME_DATA"]},
    "event_ref": {"type": ["string", "null"]},
    "start_year": {"type": ["integer", "null"]},
    "end_year": {"type": ["integer", "null"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}

