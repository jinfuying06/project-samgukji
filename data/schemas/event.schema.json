{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tkaf.local/schemas/event.schema.json",
  "title": "Event",
  "description": "A historical/narrative event (e.g. a battle). Start/end are ranges with explicit uncertainty, never a single false-precise date, and each event tracks which source layers cover it separately.",
  "type": "object",
  "required": ["event_id", "event_name", "participants", "source_layer_coverage"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^event\\.[a-z0-9_]+$" },
    "event_name": { "type": "string" },
    "event_name_zh": { "type": "string" },
    "start_time": {
      "type": "object",
      "properties": {
        "value": { "type": ["string", "null"], "description": "Best-estimate date/period, or null if unknown (never coerced to a guess)." },
        "uncertainty": { "type": "string", "enum": ["none", "low", "medium", "high", "unknown"] }
      },
      "additionalProperties": false
    },
    "end_time": {
      "type": "object",
      "properties": {
        "value": { "type": ["string", "null"] },
        "uncertainty": { "type": "string", "enum": ["none", "low", "medium", "high", "unknown"] }
      },
      "additionalProperties": false
    },
    "location": { "type": ["string", "null"] },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["person_id", "role", "source_layer"],
        "properties": {
          "person_id": { "type": "string", "pattern": "^person\\.[a-z0-9_]+$" },
          "role": { "type": "string", "description": "e.g. commander, advisor, defector; free text, not a ranking." },
          "source_layer": { "type": "string", "enum": ["HISTORY_BASE", "HISTORY_ANNOTATION", "ROMANCE", "LATER_INTERPRETATION", "GAME_DATA"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "outcome": { "type": ["string", "null"] },
    "source_layer_coverage": {
      "type": "array",
      "items": { "type": "string", "enum": ["HISTORY_BASE", "HISTORY_ANNOTATION", "ROMANCE", "LATER_INTERPRETATION", "GAME_DATA"] },
      "description": "Which layers actually describe this event; HISTORY_BASE and ROMANCE accounts are compared, never merged into one narrative."
    },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
