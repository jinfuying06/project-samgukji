{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/event.schema.json",
  "title": "Source-Aware Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "name", "source_layer", "evidence_refs", "participants"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^EVT-[0-9]{4,}$"},
    "name": {"type": "string"},
    "source_layer": {"enum": ["HISTORY_BASE", "HISTORY_ANNOTATION", "ROMANCE", "LATER_INTERPRETATION", "GAME_DATA"]},
    "start_year_min": {"type": ["integer", "null"]},
    "start_year_max": {"type": ["integer", "null"]},
    "end_year_min": {"type": ["integer", "null"]},
    "end_year_max": {"type": ["integer", "null"]},
    "location_refs": {"type": "array", "items": {"type": "string"}},
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["person_id", "role"],
        "properties": {
          "person_id": {"type": "string"},
          "role": {"type": "string"}
        }
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}

