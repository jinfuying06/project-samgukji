{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/evidence.schema.json",
  "title": "Source Evidence Span",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "source_id", "source_layer", "locator", "text_status", "review_status", "entity_refs"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EVD-[0-9]{5,}$"},
    "source_id": {"type": "string"},
    "source_layer": {"enum": ["HISTORY_BASE", "HISTORY_ANNOTATION", "ROMANCE", "LATER_INTERPRETATION", "GAME_DATA"]},
    "locator": {"type": "string", "minLength": 1},
    "text_status": {"enum": ["original", "licensed_translation", "project_translation", "paraphrase", "location_only"]},
    "text": {"type": ["string", "null"]},
    "entity_refs": {"type": "array", "items": {"type": "string"}},
    "event_refs": {"type": "array", "items": {"type": "string"}},
    "review_status": {"enum": ["unreviewed", "single_review", "double_review", "adjudicated"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "ambiguity_note": {"type": ["string", "null"]}
  }
}

